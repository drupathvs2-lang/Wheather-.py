# ---------------- DATABASE ----------------


def get_db():
    return psycopg2.connect(
        DATABASE_URL,
        sslmode="require",
        connect_timeout=10,
    )


def init_db():
    with get_db() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    user_id BIGINT PRIMARY KEY,
                    username TEXT,
                    joined_at TIMESTAMPTZ DEFAULT NOW()
                )
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS clones (
                    id SERIAL PRIMARY KEY,
                    owner_id BIGINT NOT NULL,
                    bot_token TEXT UNIQUE NOT NULL,
                    bot_username TEXT,
                    start_message TEXT DEFAULT
                        'Hello {name}! Welcome to my bot.',
                    start_photo TEXT,
                    about_text TEXT DEFAULT 'Welcome to my bot!',
                    required_channel TEXT,
                    created_at TIMESTAMPTZ DEFAULT NOW()
                )
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS clone_users (
                    clone_id INTEGER NOT NULL
                        REFERENCES clones(id) ON DELETE CASCADE,
                    user_id BIGINT NOT NULL,
                    PRIMARY KEY (clone_id, user_id)
                )
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS clone_broadcasts (
                    id SERIAL PRIMARY KEY,
                    clone_id INTEGER NOT NULL
                        REFERENCES clones(id) ON DELETE CASCADE,
                    sent_count INTEGER DEFAULT 0,
                    created_at TIMESTAMPTZ DEFAULT NOW()
                )
            """)

        conn.commit()


def save_user(user):
    with get_db() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO users (user_id, username)
                VALUES (%s, %s)
                ON CONFLICT (user_id)
                DO UPDATE SET username = EXCLUDED.username
            """, (user.id, user.username))
        conn.commit()


def get_clone(clone_id):
    with get_db() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute(
                "SELECT * FROM clones WHERE id = %s",
                (clone_id,),
            )
            row = cur.fetchone()
            return dict(row) if row else None


def get_clone_by_token(token):
    with get_db() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute(
                "SELECT * FROM clones WHERE bot_token = %s",
                (token,),
            )
            row = cur.fetchone()
            return dict(row) if row else None


def get_owner_clones(owner_id):
    with get_db() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute(
                "SELECT * FROM clones WHERE owner_id = %s ORDER BY id DESC",
                (owner_id,),
            )
            return [dict(row) for row in cur.fetchall()]


