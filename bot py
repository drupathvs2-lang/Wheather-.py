async def clone_token_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    if not context.user_data.get("awaiting_clone_token"):
        return

    token = update.message.text.strip()
    context.user_data["awaiting_clone_token"] = False

    # Validate the token with Telegram before saving it.
    try:
        response = requests.get(
            f"https://api.telegram.org/bot{token}/getMe",
            timeout=15,
        )
        data = response.json()

        if not data.get("ok"):
            await update.message.reply_text(
                "❌ Invalid bot token. Please create a bot with @BotFather "
                "and try again."
            )
            return

        bot_info = data["result"]
        bot_username = bot_info["username"]

    except Exception:
        await update.message.reply_text(
            "Could not validate the token. Please try again later."
        )
        return

    try:
        with get_db() as conn:
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO clones (owner_id, bot_token, bot_username)
                    VALUES (%s, %s, %s)
                    ON CONFLICT (bot_token) DO NOTHING
                    RETURNING id
                """, (update.effective_user.id, token, bot_username))

                row = cur.fetchone()
                if row is None:
                    await update.message.reply_text(
                        "This bot token has already been registered."
                    )
                    return

                clone_id = row[0]
            conn.commit()

        await update.message.reply_text(
            f"✅ Bot @{bot_username} registered!\n\n"
            "Open My Clones to configure its start message, picture, "
            "About section, statistics, and broadcast."
        )

        await update.message.reply_text(
            "Your bot is registered, but its polling worker must be started "
            "by the bot manager. Use /myclones to manage your bot."
        )

    except Exception:
        logger.exception("Clone registration failed")
        await update.message.reply_text(
            "Could not save your bot. Check the database configuration."
        )


