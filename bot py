async def clone_settings(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query
    await query.answer()

    parts = query.data.split(":")
    action = parts[0]
    clone_id = int(parts[1])

    clone = get_clone(clone_id)

    if not clone or clone["owner_id"] != query.from_user.id:
        await query.message.reply_text(
            "You can only manage bots that you own."
        )
        return

    if action == "photo":
        context.user_data["editing_clone"] = clone_id
        context.user_data["edit_action"] = "photo"
        await query.message.reply_text(
            "Send the picture you want to use as your bot's start picture."
        )

    elif action == "message":
        context.user_data["editing_clone"] = clone_id
        context.user_data["edit_action"] = "message"
        await query.message.reply_text(
            "Send the new start message. You can use {name} for the user's name."
        )

    elif action == "aboutedit":
        context.user_data["editing_clone"] = clone_id
        context.user_data["edit_action"] = "about"
        await query.message.reply_text("Send your new About text.")

    elif action == "stats":
        with get_db() as conn:
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT COUNT(*) FROM clone_users WHERE clone_id = %s",
                    (clone_id,),
                )
                users = cur.fetchone()[0]

                cur.execute(
                    "SELECT COUNT(*) FROM clone_broadcasts WHERE clone_id = %s",
                    (clone_id,),
                )
                broadcasts = cur.fetchone()[0]

        await query.message.reply_text(
            f"📊 Statistics for @{clone['bot_username']}\n\n"
            f"Users: {users}\n"
            f"Broadcasts: {broadcasts}"
        )

    elif action == "broadcast":
        context.user_data["editing_clone"] = clone_id
        context.user_data["edit_action"] = "broadcast"
        await query.message.reply_text(
            "Send the text you want to broadcast to your clone's users."
        )

    elif action == "refresh":
        await query.message.reply_text(
            f"Settings for @{clone['bot_username']}",
            reply_markup=clone_keyboard(clone_id),
        )


async def edit_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    action = context.user_data.get("edit_action")
    clone_id = context.user_data.get("editing_clone")

    if not action or not clone_id:
        return

    clone = get_clone(clone_id)

    if not clone or clone["owner_id"] != update.effective_user.id:
        context.user_data.pop("edit_action", None)
        context.user_data.pop("editing_clone", None)
        return

    if action == "photo":
        if not update.message.photo:
            await update.message.reply_text("Please send a photo.")
            return

        value = update.message.photo[-1].file_id
        column = "start_photo"

    elif action == "message":
        value = update.message.text
        column = "start_message"

    elif action == "about":
        value = update.message.text
        column = "about_text"

    elif action == "broadcast":
        value = update.message.text
        context.user_data.pop("edit_action", None)
        context.user_data.pop("editing_clone", None)

        with get_db() as conn:
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT user_id FROM clone_users WHERE clone_id = %s",
                    (clone_id,),
                )
                user_ids = [row[0] for row in cur.fetchall()]

        # Broadcasting requires a running bot for this token.
        await update.message.reply_text(
            f"Broadcast prepared for {len(user_ids)} registered users. "
            "The clone's polling worker must be active to send messages."
        )
        return

    else:
        return

    with get_db() as conn:
        with conn.cursor() as cur:
            # Column names are selected only from the fixed allowlist above.
            cur.execute(
                f"UPDATE clones SET {column} = %s WHERE id = %s",
                (value, clone_id),
            )
        conn.commit()

    context.user_data.pop("edit_action", None)
    context.user_data.pop("editing_clone", None)

    await update.message.reply_text("✅ Settings saved!")


