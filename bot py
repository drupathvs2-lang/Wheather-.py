async def check_membership(bot, user_id):
    try:
        member = await bot.get_chat_member(CHANNEL, user_id)
        return member.status in ("member", "administrator", "creator")
    except Exception:
        logger.exception("Channel membership check failed")
        return False


async def weather_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query
    await query.answer()

    if not await check_membership(context.bot, query.from_user.id):
        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("📢 Join Channel", url=CHANNEL_URL)],
            [InlineKeyboardButton("✅ Verify", callback_data="verify")],
        ])
        await query.message.reply_text(
            "Please join our channel before using weather features.",
            reply_markup=keyboard,
        )
        return

    await query.message.reply_text(
        "Send your location using Telegram's attachment menu "
        "and choose Location."
    )


async def verify_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query
    await query.answer()

    if await check_membership(context.bot, query.from_user.id):
        await query.message.reply_text(
            "Membership verified! Choose a feature.",
            reply_markup=main_keyboard(),
        )
    else:
        await query.message.reply_text(
            "I couldn't verify your membership. Join the channel and try again."
        )


async def location_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    location = update.message.location
    user = update.effective_user
    save_user(user)

    if not API_KEY:
        await update.message.reply_text(
            "Weather API is not configured. Please contact the administrator."
        )
        return

    lat, lon = location.latitude, location.longitude

    try:
        response = requests.get(
            "https://api.openweathermap.org/data/2.5/weather",
            params={
                "lat": lat,
                "lon": lon,
                "appid": API_KEY,
                "units": "metric",
            },
            timeout=15,
        )
        response.raise_for_status()
        data = response.json()

        city = data.get("name", "Your location")
        temperature = data["main"]["temp"]
        description = data["weather"][0]["description"]

        await update.message.reply_text(
            f"🌦 Weather at {city}\n\n"
            f"🌡 Temperature: {temperature}°C\n"
            f"☁️ Condition: {description.title()}"
        )

    except Exception:
        logger.exception("Weather lookup failed")
        await update.message.reply_text(
            "Unable to retrieve weather right now. Please try again later."
        )


