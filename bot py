        f"Total users: {users}\n"
        f"Registered clones: {clones}\n\n"
        f"Use /broadcast <message> to broadcast to main-bot users."
    )


async def main_broadcast(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("You are not authorized.")
        return

    message = " ".join(context.args).strip()
    if not message:
        await update.message.reply_text(
            "Usage: /broadcast Your message here"
        )
        return

    with get_db() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT user_id FROM users")
            user_ids = [row[0] for row in cur.fetchall()]

    sent = 0
    for user_id in user_ids:
        try:
            await context.bot.send_message(user_id, message)
            sent += 1
        except Exception:
            logger.warning("Broadcast failed for user %s", user_id)

        await asyncio.sleep(0.05)

    await update.message.reply_text(
        f"Broadcast finished.\nSent successfully: {sent}/{len(user_ids)}"
    )


async def buttons(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query
    data = query.data

    if data == "home":
        await query.answer()
        await query.message.reply_text(
            "Choose an option:",
            reply_markup=main_keyboard(),
        )

    elif data == "about":
        await about(update, context)

    elif data in ("weather", "rain"):
        await weather_callback(update, context)

    elif data == "verify":
        await verify_callback(update, context)

    elif data == "create_clone":
        await create_clone(update, context)

    elif ":" in data:
        await clone_settings(update, context)


